# ============================================
# API Keys（复制为 .env 后填入真实值）
# ============================================

# DeepSeek V4（核心推理引擎）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Tavily Search API（联网检索，免费额度 1000 次/月）
TAVILY_API_KEY=tvly-your-key-here

# 元典智库 API（法律专业检索）
# 注册地址：https://open.chineselaw.com/
YUANDIAN_APP_KEY=your-app-key-here
YUANDIAN_APP_SECRET=your-app-secret-here

# ============================================
# 应用配置
# ============================================
APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# SQLite 数据库路径（相对于 backend 目录）
DATABASE_URL=sqlite:///./data/app.db

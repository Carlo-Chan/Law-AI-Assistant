# ============================================
# API Keys（复制为 .env 后填入真实值）
# ============================================

# DeepSeek V4（核心推理引擎）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Tavily Search API（联网检索，免费额度 1000 次/月）
TAVILY_API_KEY=tvly-your-key-here

# 元典智库 API（法律专业检索）
# 注册地址：https://open.chineselaw.com/
YUANDIAN_API_KEY=your-api-key-here

# ============================================
# 应用配置
# ============================================
APP_ENV=development
# 应用日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
APP_LOG_LEVEL=INFO
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# SQLite 数据库路径（相对于 backend 目录）
DATABASE_URL=sqlite:///./data/app.db

# DOC 自动转换：安装 LibreOffice；留空时查找 PATH 和标准安装目录。
# Windows 建议指定完整的 soffice.com 路径，不要附加命令参数。
LIBREOFFICE_PATH=
# 单次转换超时（秒），允许 1—120；每个后端进程最多同时转换 2 个文件。
DOC_CONVERSION_TIMEOUT_SECONDS=45
# 可选临时目录，必须已存在且为绝对路径；留空使用系统临时目录。
DOC_CONVERSION_TEMP_DIR=
